DATABASE_URL="file:./dev.db"

# https://www.data.go.kr -> 회원가입 -> "관세청_품목별 국가별 수출입실적(GW)" 활용신청
TRADE_API_SERVICE_KEY=

# https://webservice.rakuten.co.jp/app/create -> 앱 등록 (2026년 5월 API 개편 이후 방식)
# "허용된 IP 주소" 칸에 실제 요청이 나가는 서버의 공인 IP를 등록해야 동작함 (IP 화이트리스트)
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# https://e.developer.yahoo.co.jp/dashboard -> 애플리케이션 등록 (보류 중 — 일본 전화번호 인증 이슈)
YAHOO_APP_ID=

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
