# Neon Postgres 연결 문자열. Vercel 프로젝트의 Storage 탭에서 Neon DB를 만들면 자동으로 채워지고,
# 로컬 개발도 같은 Neon DB(또는 neon.tech에서 만든 별도 dev 브랜치)에 연결해서 씀.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# https://www.data.go.kr -> 회원가입 -> "관세청_품목별 국가별 수출입실적(GW)" 활용신청
TRADE_API_SERVICE_KEY=

# https://webservice.rakuten.co.jp/app/create -> 앱 등록 (2026년 5월 API 개편 이후 방식)
# "허용된 IP 주소" 칸에 실제 요청이 나가는 서버의 공인 IP를 등록해야 동작함 (IP 화이트리스트)
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# https://e.developer.yahoo.co.jp/dashboard -> 애플리케이션 등록 (보류 중 — 일본 전화번호 인증 이슈)
YAHOO_APP_ID=

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# https://partners.coupang.com -> [추가기능] -> 파트너스API -> API 생성하기
# (메뉴가 안 보이면 partners@coupang.com 으로 API 키 발급 요청 메일 필요, 승인 1~2일)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# https://www.naver.com/ 계정으로 https://console.ncloud.com (NAVER API HUB) 가입 ->
# "AI·Application Service" -> "AI NAVER API" -> "DataLab (쇼핑인사이트)" 신청
# 쇼핑 검색 API(상품/가격)는 2026-07-31 종료됐고, 쇼핑인사이트(카테고리 클릭 추이)만 이관되어
# 무료로 계속 사용 가능. https://naverapihub.apigw.ntruss.com 도메인으로 호출.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
