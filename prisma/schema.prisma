// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SavedCandidate {
  id                  Int      @id @default(autoincrement())
  keyword             String
  hsCode              String
  tradeSignalJson     String
  japanCandidateJson  String
  marginInputJson     String
  marginResultJson    String
  aiComment           String?
  createdAt           DateTime @default(now())
}

// 사용자가 업로드한 도매 사이트(예: 슈퍼딜리버리) 상품 CSV를 파싱해서 저장.
// 정식 API가 없어서, 회원이 승인받은 공급사의 상품 정보를 공식 CSV
// 다운로드 기능으로 받아 직접 업로드하는 방식.
model WholesaleItem {
  id               Int      @id @default(autoincrement())
  source           String
  productName      String
  code             String?
  wholesalePriceJpy Float
  referencePriceJpy Float?
  rawJson          String
  uploadedAt       DateTime @default(now())
}
