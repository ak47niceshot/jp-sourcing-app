// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SavedCandidate {
  id                  Int      @id @default(autoincrement())
  keyword             String
  hsCode              String
  tradeSignalJson     String
  japanCandidateJson  String
  marginInputJson     String
  marginResultJson    String
  aiComment           String?
  createdAt           DateTime @default(now())
}

// "동향" 대시보드 순위를 주기적으로 스냅샷 저장 — 네이버 API는 최근 몇 개월치만 주기 때문에,
// 우리 자체적으로 시계열을 쌓아야 나중에 "네이버 관심 상승 vs 관세청 수입량 반응 시차" 같은
// 리드-래그 분석이 가능해진다. keyword+categoryCode당 주 1회 정도만 쌓이도록 저장 시점에서
// 중복 방지(같은 주 안에 이미 있으면 skip)한다.
model TrendSnapshot {
  id             Int      @id @default(autoincrement())
  keyword        String
  categoryCode   String
  categoryLabel  String
  recentAvg      Float
  growthPercent  Float
  capturedAt     DateTime @default(now())

  @@index([keyword, categoryCode, capturedAt])
}

// AI 소싱 추천(웹 검색 포함 Claude 호출) 결과를 캐싱 — 방문할 때마다 다시 돌리면
// 크레딧이 너무 많이 들어서, 하루에 한 번 정도만 새로 계산하고 그 사이엔 이 캐시를 보여준다.
// 파라미터가 없는 단일 결과라 항상 id=1 하나만 사용(upsert).
model SourcingAdvisorCache {
  id                  Int      @id
  recommendationsJson String
  generatedAt         DateTime @default(now())
}

// 사용자가 업로드한 도매 사이트(예: 슈퍼딜리버리) 상품 CSV를 파싱해서 저장.
// 정식 API가 없어서, 회원이 승인받은 공급사의 상품 정보를 공식 CSV
// 다운로드 기능으로 받아 직접 업로드하는 방식.
model WholesaleItem {
  id               Int      @id @default(autoincrement())
  source           String
  productName      String
  code             String?
  wholesalePriceJpy Float
  referencePriceJpy Float?
  rawJson          String
  uploadedAt       DateTime @default(now())
}
